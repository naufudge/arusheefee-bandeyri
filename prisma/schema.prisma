// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// Staff table - unified person model used both for PV signatories
// and for system login (Azure Entra ID).
model Staff {
  id          String @id @default(cuid())
  name        String
  designation String

  // Dhivehi (Thaana) localization, used by Dhivehi forms/reports (e.g. the
  // Petty Cash Reconciliation Report). Optional — filled when needed.
  dhivehiName        String?
  dhivehiDesignation String?

  // Auth / identity (added when Azure SSO was introduced)
  email       String?   @unique
  azureOid    String?   @unique
  jobTitle    String?
  department  String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  // "legacy" = pre-existing staff before SSO
  // "login"  = upserted on first sign-in
  // "sync"   = inserted via tenant sync (may not have logged in yet)
  source      String    @default("legacy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Staff can be referenced in multiple roles across PVs
  preparedPVs      PV[] @relation("PreparedBy")
  verifiedPVs      PV[] @relation("VerifiedBy")
  authorisedOnePVs PV[] @relation("AuthorisedByOne")
  authorisedTwoPVs PV[] @relation("AuthorisedByTwo")
  rejectedPVs      PV[] @relation("RejectedBy")
  postedPVs        PV[] @relation("PostedBy")

  // Petty cash role assignments (one row per signed role on one PettyCash)
  pettyCashRoles PettyCashStaff[]

  // GSR form role assignments
  requestedGSRs  GSRForm[] @relation("GSRRequestedBy")
  authorizedGSRs GSRForm[] @relation("GSRAuthorizedBy")
  receivedGSRs   GSRForm[] @relation("GSRReceivedBy")
  rejectedGSRs   GSRForm[] @relation("GSRRejectedBy")

  // Petty cash reconciliation report role assignments
  preparedPcRecons   PcReconciliation[] @relation("PcReconPreparedBy")
  checkedPcRecons    PcReconciliation[] @relation("PcReconCheckedBy")
  authorizedPcRecons PcReconciliation[] @relation("PcReconAuthorizedBy")
  rejectedPcRecons   PcReconciliation[] @relation("PcReconRejectedBy")

  // Approval timeline: every event this staff member triggered
  // (sent/verified/authorised/rejected) across PVs and petty cash.
  approvalEvents ApprovalEvent[] @relation("ApprovalActor")

  attachments Attachment[]

  // Reusable PV templates the staff has saved (shared across the team).
  pvTemplates PvTemplate[] @relation("PvTemplateCreator")

  // RBAC: a Staff can have many Roles
  roles Role[] @relation("StaffRoles")

  @@map("staff")
}

// RBAC: a Role bundles a set of permission strings and is assigned to staff.
// Roles are user-managed via the Settings UI. Permissions are app-defined
// (see lib/permissions.ts). System roles (e.g. "Administrator") cannot be
// deleted from the UI.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Array of permission keys from the catalog in lib/permissions.ts.
  // Validation that each entry is a known key is enforced in app code.
  permissions String[]
  isSystem    Boolean  @default(false)

  staff Staff[] @relation("StaffRoles")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// Main Payment Voucher table
model PV {
  id           String   @id @default(cuid())
  pvNum        String   @unique
  businessArea Int      @default(1506)
  agency       String   @default("National Archives of Maldives")
  vendor       String
  date         DateTime
  notes        String
  currency     String   @default("MVR")
  exchangeRate Float    @default(1)

  // Payment details
  poNum         String?
  paymentMethod String
  parkedDate    DateTime?
  postingDate   DateTime?
  transferNum   String?

  // Clearing document (embedded as fields since it's 1:1)
  clearingDocNum  String?
  clearingDocDate DateTime?

  // Staff relations (foreign keys)
  preparedById      String?
  verifiedById      String?
  authorisedByOneId String?
  authorisedByTwoId String?

  preparedBy      Staff? @relation("PreparedBy", fields: [preparedById], references: [id])
  verifiedBy      Staff? @relation("VerifiedBy", fields: [verifiedById], references: [id])
  authorisedByOne Staff? @relation("AuthorisedByOne", fields: [authorisedByOneId], references: [id])
  authorisedByTwo Staff? @relation("AuthorisedByTwo", fields: [authorisedByTwoId], references: [id])

  // ----- Approval workflow -----
  // `status` drives the state machine. `*At` columns are load-bearing —
  // they decide whether the PDF renders the corresponding signature. On
  // callback or rejection back to DRAFT, the relevant `*At` columns are
  // cleared (the assignee FKs above stay put).
  status            PVStatus  @default(DRAFT)
  verifiedAt        DateTime?
  authorisedByOneAt DateTime?
  authorisedByTwoAt DateTime?
  rejectedAt        DateTime?
  rejectedById      String?
  rejectionComment  String?

  // ----- Posting -----
  // After a PV is APPROVED, a `pv:post` holder posts it (terminal POSTED
  // status). `postedAt` gates the posted signature on the PDF.
  postedAt   DateTime?
  postedById String?

  rejectedBy     Staff?          @relation("RejectedBy", fields: [rejectedById], references: [id])
  postedBy       Staff?          @relation("PostedBy", fields: [postedById], references: [id])
  approvalEvents ApprovalEvent[]

  // Invoice relation (one-to-many)
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("pvs")
}

// Invoice line items within a PV
model Invoice {
  id            String    @id @default(cuid())
  comments      String
  documentNum   String?
  invoiceNumber String?
  invoiceDate   DateTime?
  invoiceTotal  Float

  // Parent PV relation
  pvId String
  pv   PV     @relation(fields: [pvId], references: [id], onDelete: Cascade)

  // GL Details relation (one-to-many)
  glDetails GLDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// GL (General Ledger) account distribution
model GLDetail {
  id     String @id @default(cuid())
  code   Int
  fund   String @default("C-GOM")
  amount Float

  // Parent Invoice relation
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("gl_details")
}

// ----- Petty cash request -----
model PettyCash {
  id                  String   @id @default(cuid())
  pettyCashNum        String   @unique
  date                DateTime
  formNum             String
  sectionUnit         String
  totalRequiredAmount Float
  glCode              Int

  // gated by separate permissions (see lib/permissions.ts)
  parkedDate  DateTime?
  postingDate DateTime?

  // Five staff role FKs; each is a 1:1 to its own PettyCashStaff record
  handledById             String? @unique
  procurementApprovedById String? @unique
  budgetCheckedById       String? @unique
  balanceHandedOverById   String? @unique
  balanceCollectedById    String? @unique

  handledBy             PettyCashStaff? @relation("HandledBy", fields: [handledById], references: [id])
  procurementApprovedBy PettyCashStaff? @relation("ProcurementApprovedBy", fields: [procurementApprovedById], references: [id])
  budgetCheckedBy       PettyCashStaff? @relation("BudgetCheckedBy", fields: [budgetCheckedById], references: [id])
  balanceHandedOverBy   PettyCashStaff? @relation("BalanceHandedOverBy", fields: [balanceHandedOverById], references: [id])
  balanceCollectedBy    PettyCashStaff? @relation("BalanceCollectedBy", fields: [balanceCollectedById], references: [id])

  items PettyCashItem[]

  // Approval timeline events for this petty cash (role approvals, rejects,
  // and resets-on-edit). Used by the detail page to render history.
  approvalEvents ApprovalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("petty_cash")
}

// ----- Per-role signature/approval entry -----
// One row per signed role on one PettyCash. Refers to the underlying Staff
// member. Lifecycle is owned by the PettyCash: create/update replace these
// rows wholesale, and delete cleans them up in the same transaction.
model PettyCashStaff {
  id         String   @id @default(cuid())
  staffId    String
  amount     Float?
  isApproved Boolean  @default(false)
  date       DateTime

  // Approval workflow metadata. `date` above is the transaction date the
  // form captures; `approvedAt` is the actual timestamp of the approve
  // action (set when `isApproved` flips to true).
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionComment String?

  staff Staff @relation(fields: [staffId], references: [id])

  // Back-relations: at most one of these is set per row (the role used).
  handledFor             PettyCash? @relation("HandledBy")
  procurementApprovedFor PettyCash? @relation("ProcurementApprovedBy")
  budgetCheckedFor       PettyCash? @relation("BudgetCheckedBy")
  balanceHandedOverFor   PettyCash? @relation("BalanceHandedOverBy")
  balanceCollectedFor    PettyCash? @relation("BalanceCollectedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("petty_cash_staff")
}

// ----- Line items on a petty cash request -----
model PettyCashItem {
  id          String  @id @default(cuid())
  qty         Int
  name        String? // English name; either this or nameDhivehi must be set
  nameDhivehi String? // Dhivehi (Thaana) name, used by Dhivehi reports

  pettyCashId String
  pettyCash   PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)

  @@map("petty_cash_items")
}

model Attachment {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  description        String
  mimeType           String?
  originalName       String?
  sharepointFileName String?  @unique
  createdById        String
  reference_id       String
  reference_type     String
  sharepointUrl      String?
  createdBy          Staff    @relation(fields: [createdById], references: [id])
}

// ----- PV Templates -----
// A reusable set of pre-filled PV values, surfaced on the Create PV form
// via the template picker. The PV number is intentionally excluded; the
// stored `values` blob is a partial of the PV create payload, validated
// in app code by `templateValuesSchema` before persisting.
model PvTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Partial PV values (jsonb). Shape lives in
  // server/schemas/template.schema.ts.
  values Json

  createdById String
  createdBy   Staff  @relation("PvTemplateCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pv_templates")
}

// ----- Goods / Service Requisition Form (GSR) -----
// Mirrors the PV approval workflow: a requester drafts the form, an
// authoriser approves it, and an optional receiver acknowledges receipt.
// `gsrNum` is the human-readable key, entered manually (must be unique).
model GSRForm {
  id         String   @id @default(cuid())
  gsrFormNum String   @unique
  section    String // Dhivehi section/unit (e.g. "އެޑްމިން، ފައިނޭންސް އެންޑް އައި.ޓީ.")
  date       DateTime

  // Staff role foreign keys
  requestedById  String?
  authorizedById String?
  receivedById   String?

  requestedBy  Staff? @relation("GSRRequestedBy", fields: [requestedById], references: [id])
  authorizedBy Staff? @relation("GSRAuthorizedBy", fields: [authorizedById], references: [id])
  receivedBy   Staff? @relation("GSRReceivedBy", fields: [receivedById], references: [id])

  // ----- Approval workflow -----
  // `status` drives the state machine. `*At` columns gate whether the PDF
  // renders the corresponding signature; they're cleared on reject back to
  // DRAFT. Form Received By is optional: authorising with no receiver
  // assigned completes the form directly.
  status           GSRStatus @default(DRAFT)
  authorizedAt     DateTime?
  receivedAt       DateTime?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionComment String?

  rejectedBy     Staff?          @relation("GSRRejectedBy", fields: [rejectedById], references: [id])
  approvalEvents ApprovalEvent[]

  items GSRItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("gsr_forms")
}

// ----- Line items on a GSR form -----
model GSRItem {
  id           String    @id @default(cuid())
  particulars  String
  requestedQty Int
  issuedQty    Int?
  rqdDate      DateTime?
  remarks      String? // Dhivehi remarks

  gsrFormId String
  gsrForm   GSRForm @relation(fields: [gsrFormId], references: [id], onDelete: Cascade)

  @@map("gsr_items")
}

// ----- Petty Cash Reconciliation Report -----
// A weekly (Sunday→Thursday) Dhivehi safe/treasury statement. Items are
// snapshotted from the week's petty cash records when the report is sent for
// approval. Workflow mirrors the GSR/PV state machine:
// DRAFT → PENDING_CHECK → PENDING_AUTHORIZATION → COMPLETED.
model PcReconciliation {
  id         String   @id @default(cuid())
  reportNum  String   @unique // "NN/YYYY", auto-suggested but editable
  weekStart  DateTime // Sunday 00:00 UTC
  weekEnd    DateTime // Thursday UTC
  periodText String // Dhivehi period text, e.g. "04 ޖަނަވަރީ 2026 ން 08 ޖަނަވަރީ 2026 އަށް"

  // Manual cash-composition figures. The grand total (cashHeld + chequeHeld)
  // is computed in the form/PDF and not stored.
  openingBalance   Float @default(0)
  cashInHand       Float @default(0)
  redepositAcc1155 Float @default(0)
  staffWages       Float @default(0)
  foodAllowance    Float @default(0)
  heldInCheque     Float @default(0)
  totalPayable     Float @default(0)
  total            Float @default(0)
  cashHeld         Float @default(0)
  chequeHeld       Float @default(0)

  // Staff role foreign keys
  preparedById   String?
  checkedById    String?
  authorizedById String?

  preparedBy   Staff? @relation("PcReconPreparedBy", fields: [preparedById], references: [id])
  checkedBy    Staff? @relation("PcReconCheckedBy", fields: [checkedById], references: [id])
  authorizedBy Staff? @relation("PcReconAuthorizedBy", fields: [authorizedById], references: [id])

  // ----- Approval workflow -----
  status           PcReconStatus @default(DRAFT)
  checkedAt        DateTime?
  authorizedAt     DateTime?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionComment String?

  rejectedBy     Staff?          @relation("PcReconRejectedBy", fields: [rejectedById], references: [id])
  approvalEvents ApprovalEvent[]

  items PcReconciliationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("pc_reconciliations")
}

// Snapshot transaction row, one per petty cash record in the report's week.
model PcReconciliationItem {
  id                 String   @id @default(cuid())
  date               DateTime // the source petty cash date
  details            String // comma-joined Dhivehi item names
  detailsEn          String? // comma-joined English item names (fallback)
  withdrawn          Float // PettyCash.totalRequiredAmount
  sourcePettyCashNum String? // provenance, for the Dhivehi-gate links
  sortOrder          Int      @default(0)

  reconciliationId String
  reconciliation   PcReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@map("pc_reconciliation_items")
}

// ----- Asset register -----
// Flat registry row, one per physical asset (plain CRUD — no approval
// workflow). `assetNum` is the human-readable key (e.g. 433-18-02-15-79-01)
// and doubles as the URL slug. `category` (the main category) and
// `assetType` (the Excel sheet name / leaf type) are denormalised onto the
// row so the export can regroup assets into one-sheet-per-type with the
// category header without re-deriving the taxonomy.
model Asset {
  id String @id @default(cuid())

  assetNum       String  @unique // "Asset Number" — slug + unique key
  SAPassetNum    String? // "SAP Asset No." — often blank
  assetName      String // "Asset Name & Description"
  modelNum       String? // "Model number" — often "-"
  manufacturerId String? // "Manufacturer ID" — often "-"
  classification String? // "Classification" e.g. Z652

  previousLocation String?
  presentLocation  String?

  // Date-or-year: `date` always holds a real DateTime (1 Jan of the year
  // when only a year is known); `datePrecision` records whether the
  // original cell was a bare YEAR or a FULL date so export round-trips
  // losslessly.
  date          DateTime?
  datePrecision AssetDatePrecision @default(YEAR)

  price     Float? // "Price"
  condition String? // "Condition" e.g. Good

  category    String // main category (10 values)
  subcategory String? // taxonomy subcategory; the leaf for type-less subcategories
  assetType   String? // Excel sheet name / leaf type; null when the subcategory has no types

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetType])
  @@index([category])
  @@index([subcategory])
  @@map("assets")
}

// Whether an Asset's `date` was recorded as a bare year or a full date.
// Drives how the date column is rendered on export so it round-trips.
enum AssetDatePrecision {
  YEAR
  FULL
}

// ----- Approval workflow -----

// Sequential state machine for a Payment Voucher.
// REJECTED is reachable from any pending state; rejection transitions
// `status` back to DRAFT in the same write (REJECTED itself is a
// transient label that lives only in the ApprovalEvent log).
enum PVStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_AUTHORISATION_ONE
  PENDING_AUTHORISATION_TWO
  APPROVED
  POSTED
  REJECTED
}

// Sequential state machine for a GSR Form. Form Received By is optional, so
// authorising with no receiver assigned goes straight to COMPLETED. REJECTED
// is a transient label (the row reverts to DRAFT in the same write).
enum GSRStatus {
  DRAFT
  PENDING_AUTHORIZATION
  PENDING_RECEIPT
  COMPLETED
  REJECTED
}

// Sequential state machine for a Petty Cash Reconciliation Report:
// DRAFT → PENDING_CHECK → PENDING_AUTHORIZATION → COMPLETED. REJECTED is a
// transient label (the row reverts to DRAFT in the same write).
enum PcReconStatus {
  DRAFT
  PENDING_CHECK
  PENDING_AUTHORIZATION
  COMPLETED
  REJECTED
}

// Discriminator for ApprovalEvent rows. PV events are sequential stages;
// PC events are per-role since PC approvals are out-of-order.
enum ApprovalEventKind {
  SENT_FOR_VERIFICATION
  CALLED_BACK
  VERIFIED
  AUTHORISED_ONE
  AUTHORISED_TWO
  REJECTED
  POSTED
  PC_ROLE_APPROVED
  PC_ROLE_REJECTED
  PC_ROLE_RESET_ON_EDIT
  GSR_SENT_FOR_AUTHORIZATION
  GSR_AUTHORIZED
  GSR_RECEIVED
  GSR_CALLED_BACK
  GSR_REJECTED
  PCRECON_SENT_FOR_CHECK
  PCRECON_CHECKED
  PCRECON_AUTHORIZED
  PCRECON_CALLED_BACK
  PCRECON_REJECTED
}

// Polymorphic timeline table. Exactly one of `pvId` / `pettyCashId` is
// set per row (mirrors the polymorphism pattern used by Attachment).
// `pettyCashRole` is populated only for PC events to identify which of
// the five roles the event refers to.
model ApprovalEvent {
  id            String            @id @default(cuid())
  kind          ApprovalEventKind
  pvId             String?
  pettyCashId      String?
  gsrFormId        String?
  pcReconciliationId String?
  pettyCashRole    String?
  actorId          String
  comment          String?
  createdAt        DateTime          @default(now())

  pv               PV?               @relation(fields: [pvId], references: [id], onDelete: Cascade)
  pettyCash        PettyCash?        @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  gsrForm          GSRForm?          @relation(fields: [gsrFormId], references: [id], onDelete: Cascade)
  pcReconciliation PcReconciliation? @relation(fields: [pcReconciliationId], references: [id], onDelete: Cascade)
  actor            Staff             @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([pvId, createdAt])
  @@index([pettyCashId, createdAt])
  @@index([gsrFormId, createdAt])
  @@index([pcReconciliationId, createdAt])
  @@map("approval_events")
}
